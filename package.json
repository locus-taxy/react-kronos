{
  "name": "@locus-taxy/react-kronos",
  "version": "1.10.1",
  "description": "A fast, intuitive, and elegant date and time picker for React.",
  "main": "lib/index.js",
  "module": "es/index.js",
  "scripts": {
    "start": "node devServer.js",
    "build": "npm run clean && npm run build:lib && npm run build:es",
    "build:lib": "NODE_ENV=production BABEL_ENV=commonjs babel src -d lib",
    "build:es": "NODE_ENV=production babel src -d es",
    "build:dev": "BABEL_ENV=development babel src -d lib",
    "build:umd": "NODE_ENV=production webpack --config webpack.config.prod.js -p",
    "build:examples": "NODE_ENV=production webpack --config examples/webpack.config.examples.js",
    "clean": "rimraf dist && rimraf lib && npm run clean:examples",
    "clean:examples": "rimraf examples/bundle.*",
    "push_examples": "./scripts/push_ghpages",
    "release": "yarn build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/locus-taxy/react-kronos"
  },
  "files": [
    "lib",
    "es",
    "package.json"
  ],
  "keywords": [
    "react",
    "react-component",
    "date",
    "time",
    "picker",
    "select",
    "input",
    "field",
    "moment",
    "calendar",
    "years",
    "months",
    "days",
    "hours"
  ],
  "author": "Mara Labs",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "7.17.6",
    "@babel/core": "7.17.5",
    "@babel/plugin-proposal-class-properties": "7.16.7",
    "@babel/plugin-proposal-function-bind": "7.16.7",
    "@babel/preset-env": "7.16.11",
    "@babel/preset-react": "7.16.7",
    "@changesets/cli": "^2.21.1",
    "babel-eslint": "8.2.1",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "prop-types": "^15.6.0",
    "react": "^16.3.1",
    "react-dom": "^16.3.1",
    "rimraf": "^2.6.2"
  },
  "dependencies": {
    "classnames": "^2.2.5",
    "color": "^0.11.4",
    "jss": "^6.5.0",
    "jss-preset-default": "^1.3.1",
    "moment": "^2.18.0",
    "moment-range": "^2.2.0"
  },
  "peerDependencies": {
    "lodash": "^4.17.5",
    "react": "^16.3.1",
    "react-dom": "^16.3.1"
  },
  "volta": {
    "node": "14.18.1",
    "yarn": "1.22.15"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
